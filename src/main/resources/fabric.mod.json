{
	"schemaVersion": 1,
	"id": "blaze-twitch-mod",
	"version": "${version}",
	"name": "BlazinBlaze Twitch Mod",
	"description": "Adds Blazin Twitch Integration to Minecraft!",
	"authors": [
		"BlazinBlaze"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/blaze-twitch-mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.blazinblaze.blazetwitchmod.BlazinBlazeTwitchMod"
		],
		"client": [
			"net.blazinblaze.blazetwitchmod.BlazinBlazeTwitchModClient"
		],
		"fabric-datagen": [
			"net.blazinblaze.blazetwitchmod.BlazinBlazeTwitchModDataGenerator"
		]
	},
	"mixins": [
		"blaze-twitch-mod.mixins.json",
		{
			"config": "blaze-twitch-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": ">=26.1",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	},
	"accessWidener": "blaze-twitch-mod.classtweaker"
